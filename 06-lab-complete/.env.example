# Copy thành .env rồi điền giá trị: cp .env.example .env
# KHÔNG commit .env (đã nằm trong .gitignore). Trên cloud, đặt các biến này ở dashboard.

# Server
PORT=8000
ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
# Số uvicorn worker trong container (mặc định 2)
WEB_CONCURRENCY=2

# Security — bắt buộc. Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis — docker compose tự đặt redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard: tổng chi phí LLM của agent (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
